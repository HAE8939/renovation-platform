// Prisma schema — renovation-platform
// SQLite for M1a; kept portable (no PG-only types: no String[], no dbgenerated,
// no native enums) so P5 can switch provider to PostgreSQL in one step.
// Enums are modeled as string + const in TS.

generator client {
  provider = "prisma-client-js"
  // linux-arm64-openssl-3.0.x 是给 NAS（aarch64 + Debian）用的显式引擎目标。
  // 不写它就得靠 Prisma 自己探测 OpenSSL 版本，而 node:22-slim 里既无 openssl CLI 也无
  // libssl.so.*，探测失败会回落到 openssl-1.1 引擎 → 运行时 "libssl.so.1.1 not found"、
  // 静态导出阶段 /_not-found 炸掉（NAS 实测）。native 保留给 Windows 本机开发。
  // 前提是镜像里必须真的装上 openssl（见 Dockerfile），否则引擎下对了也加载不了。
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 共享核心域 (core/domain) — AGENTS §4
// 预算 / 项目管理 / 设计管理 都挂在 Project 下，禁止模块重复定义。
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  clients Client[]
  users   User[]
  leads   Lead[]

  @@map("organizations")
}

// 占位表：P4 接入登录。表先建、字段留足，暂不实现认证逻辑。
model User {
  id         String   @id @default(cuid())
  orgId      String
  name       String
  email      String   @unique
  role       String   @default("viewer") // owner / designer / pm / viewer…（字符串常量，见 core/domain/types.ts）
  department String? // management | business | design | engineering
  createdAt  DateTime @default(now())

  org            Organization    @relation(fields: [orgId], references: [id])
  projectMembers ProjectMember[]
  workLogs       WorkLog[]

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id])
  projects Project[]

  @@map("clients")
}

model Project {
  id             String    @id @default(cuid())
  code           String    @unique // 项目编号，如 RP-2026-001
  name           String
  address        String?
  area           Float     @default(0) // 建筑面积㎡；0 时单方造价不可算
  clientId       String
  designer       String?
  pm             String?
  status         String    @default("draft") // draft / design / in_progress / acceptance / completed / archived
  startDate      DateTime?
  endDate        DateTime? // 计划/预计完工（B3“工期止”即此）
  contractAmount Float     @default(0) // 合同额；0=未录入（哨兵，budgetLight/毛利遇 0 走中性）
  houseType      String? // 户型
  style          String? // 风格偏好
  source         String? // 获客渠道（签约时从 Lead.source 带入，供驾驶舱归因）
  inspector      String? // 工程巡检（本期文本，P4 再改 userId）
  budgetAnalyst  String? // 预算员（同上）
  actualEndDate  DateTime? // 实际完工
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client          Client           @relation(fields: [clientId], references: [id])
  quotes          BudgetQuote[]
  lead            Lead? // 反向：签约线索（真源在 Lead.projectId @unique）
  designTasks     DesignTask[] // 反向：设计任务（M5-a，真源在 DesignTask.projectId）
  scheduleTasks   ScheduleTask[] // 反向：排程工序（M6-a，真源在 ScheduleTask.projectId）
  acceptanceNodes AcceptanceNode[] // 反向：验收节点（M7-a，真源在 AcceptanceNode.projectId）
  issues          Issue[] // 反向：质量问题（M7-a，真源在 Issue.projectId）
  financeRecords  FinanceRecord[] // 反向：收支台账（M8-a，真源在 FinanceRecord.projectId）
  paymentNodes    PaymentNode[] // 反向：付款段（M8-a，真源在 PaymentNode.projectId）
  members         ProjectMember[] // 人员工控：项目责任关系（M12-a）
  workLogs        WorkLog[]
  fileAssets      FileAsset[]
  panoTours       PanoTour[] // 反向：全景导览（M15-a，真源在 PanoTour.projectId）

  @@map("projects")
}

// ─────────────────────────────────────────────────────────────
// 人员工控模块（M12-a）
// 项目成员关系是平台共享主数据的桥：User 与 Project 均来自 core/domain，
// 本表只记录某人在某项目承担的责任与时间，不复制姓名、岗位或项目实体。
// ─────────────────────────────────────────────────────────────
model ProjectMember {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  role      String // project_manager | designer | inspector | construction_lead | coordinator
  startDate DateTime?
  endDate   DateTime?
  note      String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, role])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// ─────────────────────────────────────────────────────────────
// 预算模块自有实体 (modules/budget) — AGENTS §5
// 模块表通过 projectId 外键引用核心域。
// ─────────────────────────────────────────────────────────────

model CatalogCategory {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  items CatalogItem[]

  @@map("catalog_categories")
}

model CatalogItem {
  id           String   @id @default(cuid())
  categoryId   String
  code         String
  name         String
  unit         String   @default("项")
  defaultPrice Float    @default(0)
  defaultQty   Float    @default(1)
  materials    String   @default("") // 材料说明
  sop          String   @default("") // 施工要求，多行文本按 \n 分行
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  category CatalogCategory @relation(fields: [categoryId], references: [id])

  @@map("catalog_items")
}

model BudgetQuote {
  id        String    @id @default(cuid())
  projectId String    @unique // M1a：一项目一报价；多版本留 M1b
  taxRate   Float     @default(0.03)
  status    String    @default("draft") // draft / confirmed / locked
  note      String?
  lockedAt  DateTime? // 签约锁单时刻；null=未锁
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project       @relation(fields: [projectId], references: [id])
  items   QuoteItem[]
  changes ChangeOrder[] // 反向：变更单（M9-a，挂报价单级）

  @@map("budget_quotes")
}

// 报价明细：CatalogItem 的快照，非引用。
// 改模板不回溯历史报价 —— 这是刻意的领域决策（AGENTS §5）。
model QuoteItem {
  id           String @id @default(cuid())
  quoteId      String
  categoryName String // 快照科目名
  code         String
  name         String
  unit         String @default("项")
  unitPrice    Float  @default(0)
  quantity     Float  @default(1)
  materials    String @default("")
  sop          String @default("")
  order        Int    @default(0)

  quote BudgetQuote @relation(fields: [quoteId], references: [id])

  @@map("quote_items")
}

// ─────────────────────────────────────────────────────────────
// M2-A 全案主脊：线索与跟进（core/domain 主数据）
// Lead = 签约前线索；FollowUp = 1-N 跟进记录（非长文本）。
// 本期只落表，不接页面；M3 才从 Lead 签约回写 Project.projectId。
// ─────────────────────────────────────────────────────────────

model Lead {
  id           String    @id @default(cuid())
  orgId        String
  code         String    @unique // LEAD-YYYY-NNN
  name         String
  phone        String? // 归并键（M3 签约按此并 Client）
  estate       String? // 楼盘
  area         Float     @default(0)
  style        String?
  budgetRange  String? // 意向预算区间（文本，非精确）
  source       String? // 获客渠道
  stage        String    @default("leads") // leads | contacted | confirmed | quoted | signed
  intentLevel  String    @default("medium") // high | medium | low
  assignee     String? // 负责人（本期文本）
  lastFollowAt DateTime?
  nextFollowAt DateTime?
  archived     Boolean   @default(false) // 作废位：true=不进漏斗/看板/统计，可恢复（M10-a）
  archivedAt   DateTime? // 作废时刻；null=未作废
  projectId    String?   @unique // 签约回写，1-1；未签为 null
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org       Organization @relation(fields: [orgId], references: [id])
  project   Project?     @relation(fields: [projectId], references: [id])
  followUps FollowUp[]

  @@map("leads")
}

model FollowUp {
  id           String    @id @default(cuid())
  leadId       String
  date         DateTime  @default(now())
  content      String
  nextFollowAt DateTime?
  createdAt    DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("follow_ups")
}

// ─────────────────────────────────────────────────────────────
// 设计管理模块自有实体 (modules/design) — M5-a
// DesignTask 通过 projectId 外键引用共享 core/domain 的 Project（AGENTS §2/§4）。
// assigneeId / reviewerId 语义上是 User.id（存 userId，非自由文本），
// 但本期不建到 User 的 @relation（User 侧不加反向字段），仅逻辑引用 + @@index
// —— P4 接登录后再决定是否建外键关系，避免现在牵动 User 表。
// ─────────────────────────────────────────────────────────────
model DesignTask {
  id          String    @id @default(cuid())
  projectId   String // ★ 引用共享 core/domain Project，不得自造
  code        String    @unique // DES-YYYY-NNN
  title       String
  type        String // scheme|floorplan|rendering|construction_drawing|measurement（见 design/types.ts 常量）
  status      String    @default("pending") // pending|assigned|submitted|revisions|approved（见 design/status.ts）
  assigneeId  String? // ★ userId，非自由文本；null=待分配
  reviewerId  String? // ★ userId，审核人
  requirement String    @default("") // 需求说明，多行
  deadline    DateTime?
  priority    String    @default("medium") // high|medium|low
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project          @relation(fields: [projectId], references: [id])
  submissions TaskSubmission[]

  @@index([projectId])
  @@index([assigneeId])
  @@map("design_tasks")
}

// 任务提交记录（版本化）。M5-a 只建表不落数据；提交/审核逻辑 M5-b/M5-c。
model TaskSubmission {
  id           String    @id @default(cuid())
  taskId       String
  version      Int // 同 task 自增（服务层算 max+1）
  note         String    @default("") // 提交说明
  assetRef     String? // 交付物链接占位（本期无上传，可空）
  submittedBy  String // ★ userId
  result       String    @default("pending") // pending|approved|rejected（本次提交审核结果）
  rejectReason String? // 退回时必填（M5-c 服务层校验）
  reviewedBy   String? // ★ userId
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  task DesignTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, version])
  @@map("task_submissions")
}

// 统一文件资产：业务表只保存 ownerType/ownerId，文件元数据与存储键集中管理。
// 首期 provider 写本地 public/uploads/files，后续可无缝切换 OSS。
model FileAsset {
  id           String   @id @default(cuid())
  projectId    String?
  ownerType    String
  ownerId      String
  category     String
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  uploadedBy   String
  uploaderName String?
  createdAt    DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([ownerType, ownerId, createdAt])
  @@index([projectId, category])
  @@map("file_assets")
}

// 人员工作记录：记录事实，不直接生成绩效分数。
model WorkLog {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  workDate    DateTime
  category    String
  title       String
  description String   @default("")
  minutes     Int?
  outputNote  String   @default("")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, workDate])
  @@index([userId, workDate])
  @@map("work_logs")
}

// ─────────────────────────────────────────────────────────────
// 时间管控模块自有实体 (modules/schedule) — M6-a
// ScheduleTask 通过 projectId 外键引用共享 core/domain 的 Project（AGENTS §2/§4）。
// ownerId 语义上是 User.id（存 userId，非自由文本），与 DesignTask.assigneeId 同策略：
// 本期不建到 User 的 @relation，仅逻辑引用 + @@index，P4 接登录后再定外键关系。
// ─────────────────────────────────────────────────────────────

// 工序模板：11 工序 × 3 档（lt90 / b90_130 / gt130），生成排程时按面积档套用。
model ProcessTemplate {
  id        String   @id @default(cuid())
  name      String // 工序名（11 项）
  order     Int // 1..11，生成顺序
  tier      String // lt90 | b90_130 | gt130（见 schedule/plan.ts）
  days      Int // 标准工期（天）
  createdAt DateTime @default(now())

  @@unique([tier, order])
  @@map("process_templates")
}

// 排程工序：从模板快照生成，挂在 Project 下。改模板不回溯已生成排程。
model ScheduleTask {
  id          String    @id @default(cuid())
  projectId   String // ★ 引用共享 core/domain Project，不得自造
  name        String // 工序名（快照自模板；改模板不回溯已生成排程）
  order       Int
  startDate   DateTime // 计划开始
  endDate     DateTime // 计划结束（含当天；=start+days-1）
  actualStart DateTime?
  actualEnd   DateTime?
  progress    Int       @default(0) // 0–100 整数
  status      String    @default("pending") // pending|in_progress|completed（见 schedule/status.ts）
  ownerId     String? // ★ userId，非自由文本；null=未指派
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project    Project                  @relation(fields: [projectId], references: [id])
  deps       ScheduleTaskDependency[] @relation("sch_dep_task")
  dependents ScheduleTaskDependency[] @relation("sch_dep_dependson")

  @@index([projectId])
  @@index([ownerId])
  @@map("schedule_tasks")
}

// 自引用依赖中间表：taskId 依赖 dependsOnId（task 的前置 = dependsOn）。
model ScheduleTaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())

  task      ScheduleTask @relation("sch_dep_task", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn ScheduleTask @relation("sch_dep_dependson", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@map("schedule_task_deps")
}

// ─────────────────────────────────────────────────────────────
// 质量管控模块自有实体 (modules/quality) — M7-a
// 节点/问题经 projectId 外键引用共享 core/domain Project；
// node.taskId 为对 ScheduleTask 的【逻辑引用】（跨模块不建 @relation，仿 assigneeId 策略）。
// 检查项库仅 seed 灌入（v5.1 无编辑页）。
// ─────────────────────────────────────────────────────────────

// 检查项库（SOP）：按 stage（=工序名，与 ProcessTemplate.name 同字面）映射 11 工序。
model CheckItem {
  id        String   @id @default(cuid())
  stage     String // 工序名，如"水电工程"
  name      String // 检查项名，如"强弱电间距"
  standard  String // 验收标准
  order     Int // 工序内排序
  createdAt DateTime @default(now())

  @@unique([stage, order])
  @@map("check_items")
}

// 验收节点：工序完工自动生成（core 整合器），一工序一节点。
model AcceptanceNode {
  id           String    @id @default(cuid())
  projectId    String
  taskId       String?   @unique // ★ 逻辑引用 ScheduleTask.id；清空排程后允许悬垂
  name         String // 工序名快照
  order        Int // 工序顺序快照
  status       String    @default("pending") // pending|submitted|returned|passed
  submitNote   String    @default("") // 提交说明
  submittedBy  String? // ★ userId（占位当前用户）
  submittedAt  DateTime?
  reviewedBy   String? // ★ userId
  reviewedAt   DateTime?
  returnReason String? // 退回原因（最近一次；详情页展示）
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project  Project     @relation(fields: [projectId], references: [id])
  checks   NodeCheck[]
  issues   Issue[]
  evidence Evidence[]

  @@index([projectId])
  @@index([status])
  @@map("acceptance_nodes")
}

// M11-D：验收节点证据图片。文件落在 public/uploads/evidence，数据库只存安全文件名与元数据。
// 上传人先沿用质量模块占位用户；P4 接登录后只替换身份来源，不改表结构。
model Evidence {
  id           String   @id @default(cuid())
  nodeId       String
  filename     String // 服务端生成的文件名，不接受客户端路径
  originalName String // 仅用于页面展示
  mimeType     String // image/jpeg | image/png
  size         Int // 字节数
  uploadedBy   String // userId，占位用户；P4 接登录
  uploaderName String? // 展示名快照
  createdAt    DateTime @default(now())

  node AcceptanceNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  @@map("evidence")
}

// 节点检查项快照行：生成时从 CheckItem 拷入；提交时填结果。
model NodeCheck {
  id        String   @id @default(cuid())
  nodeId    String
  name      String // 快照
  standard  String // 快照
  order     Int
  result    String? // null=未检 | pass | fail
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  node AcceptanceNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, order])
  @@map("node_checks")
}

// 问题台账：验收退回自动建；亦可手工新建。
model Issue {
  id          String    @id @default(cuid())
  projectId   String
  nodeId      String? // 来源节点（手工建可为空）
  title       String // 问题标题
  desc        String    @default("") // 详细描述
  severity    String    @default("normal") // minor|normal|major
  status      String    @default("open") // open|rectified|closed
  reportedBy  String // ★ userId
  assigneeId  String? // ★ 责任人 userId
  dueDate     DateTime? // 截止日期
  rectifyNote String? // 整改说明
  rectifiedAt DateTime?
  recheckNote String? // 复验意见（关闭/退回共用，取最近一次）
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project         @relation(fields: [projectId], references: [id])
  node    AcceptanceNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@map("issues")
}

// ─────────────────────────────────────────────────────────────
// 财务管控模块自有实体 (modules/finance) — M8-a
// 收支记录与付款段均经 projectId 外键引用共享 core/domain Project。
// 付款段的“解锁/可收款”态【不落库】：读取时由 finance/payment.ts 纯函数派生（决策①）。
// paid/paidAt/paidBy 是唯一落库的执行事实（人工标记），不自动生 FinanceRecord（决策②）。
// ─────────────────────────────────────────────────────────────

// 收支台账：录入即入账（无审批态，§0 范围红线）。
model FinanceRecord {
  id          String   @id @default(cuid())
  projectId   String
  type        String // income | expense
  category    String // contract | change | refund | material | labor | other
  amount      Float // 恒为正数；方向由 type 决定（免符号歧义）
  date        DateTime // 发生日期
  description String   @default("") // 摘要，如“泥工班组第二期人工”
  recordedBy  String? // ★ userId（占位当前用户，P4 接登录）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([type])
  @@index([date])
  @@map("finance_records")
}

// 付款段：五段计划，金额生成时快照自 Project.contractAmount（决策④）。
model PaymentNode {
  id            String    @id @default(cuid())
  projectId     String
  order         Int // 1..5
  name          String // 段名快照，如“水电完成款”
  percent       Float // 比例快照（30 = 30%），展示用
  amountDue     Float // ★ 应收金额快照（生成时合同额 × 比例，尾差归末段）
  trigger       String // none | stages | all  —— 解锁依赖的验收条件
  triggerStages String    @default("") // 逗号分隔工序名，仅 trigger=="stages" 用
  unlocksAt     DateTime? // 可选：不早于此日可付（保修金用；null=无日期约束）
  note          String    @default("")
  paid          Boolean   @default(false)
  paidAt        DateTime?
  paidBy        String? // ★ userId
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, order])
  @@index([projectId])
  @@map("payment_nodes")
}

// ─────────────────────────────────────────────────────────────
// 预算模块自有实体（M9-a 变更单）— ChangeOrder
// 变更单挂报价单级（PLAN §7-2：禁挂 QuoteItem——报价整表替换会孤儿化）。
// 金额带符号：正=增加、负=减少（v5.1 §6.7.2“金额变化（正数=增加，负数=减少）”）。
// 变更单走草稿→待确认→客户已确认/已驳回；只有客户已确认进入金额口径。
// 附件通过共享 FileAsset 以 ownerType/ownerId 关联，保持可移植。
// ─────────────────────────────────────────────────────────────
model ChangeOrder {
  id        String   @id @default(cuid())
  quoteId   String
  kind      String // add | deduct | upgrade | process（增项/减项/材料升级/工艺变更）
  title     String // 变更描述（必填）
  amount    Float // 金额变化：正=增加、负=减少；拒 0
  date      DateTime // 变更日期
  note      String   @default("") // 原因说明
  status       String   @default("draft") // draft | pending | client_confirmed | rejected
  submittedAt  DateTime?
  submittedBy  String?
  confirmedAt  DateTime?
  confirmedBy  String?
  confirmNote  String   @default("")
  rejectReason String?
  createdBy String? // ★ userId 占位（P4 接登录）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote BudgetQuote @relation(fields: [quoteId], references: [id])

  @@index([quoteId])
  @@map("change_orders")
}

// ── M9-c：EAV 自定义字段（平台原语；定义与值两张表）──────────────────────
// 决策（TASK_M9 §1 决策 6 + §8-0）：类型五种（单行文本/多行文本/数字/日期/单选），不做金额；
// 全司共享、不做模块作用域；校验＝必填 + 类型。本期只接 Project 侧界面，entityKind 保留
// client 留位（不建客户页面）。
// 关键设计：**值按类型分列存**（valueText / valueNumber / valueDate 三列互斥）——数字与日期若
// 塞进字符串列，SQLite 的 gte/lte 会按字典序比较（"9" > "10"），区间筛选必错（§8-0-19 推论）。
model CustomFieldDef {
  id        String   @id @default(cuid())
  key       String   @unique // 稳定机读键，如 survey_date；创建后不可改
  label     String // 中文名，列表/表单/报错文案都用它
  type      String // text | textarea | number | date | select
  // 仅 select 用：**每行一个选项**的纯文本（如 "不含家电\n仅厨电"）；其余类型存 ""。
  // 为什么不用 Json：Prisma 5.22 在 SQLite 上不支持 Json 类型（`prisma validate` 实测报
  // "The current connector does not support the Json type"），而本栈开发期与首个部署就是 SQLite
  // （AGENTS §1）。按行文本比 JSON 字符串更可读、可手改、无转义坑，迁 PG 时也照样能用。
  // 清洗与解析单点在 core/domain/customField.ts 的 parseOptions（同时兼容数组入参）。
  options   String   @default("")
  required  Boolean  @default(false)
  active    Boolean  @default(true) // 停用＝不进录入、不进筛选，历史值原样保留可查
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values CustomFieldValue[]

  @@map("custom_field_defs")
}

model CustomFieldValue {
  id String @id @default(cuid())

  fieldId    String
  entityKind String // project | client
  entityId   String // Project.id / Client.id；多态指向两张表 → **不建外键**，存在性由服务层事务内校验

  valueText   String?
  valueNumber Float?
  valueDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  field CustomFieldDef @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityKind, entityId]) // 一字段 × 一实体 = 一值（upsert 的锚）
  @@index([entityKind, entityId])
  @@index([fieldId, valueNumber])
  @@index([fieldId, valueDate])
  @@map("custom_field_values")
}

// ─────────────────────────────────────────────────────────────
// M9-d 平台设置（PlatformSetting）—— 主题切换 + 品牌 Logo（core 平台原语，非业务模块）
// 决策 R1 / TASK_M9 决策 7：**只存插槽键名**（cobalt/rust/emerald/teal），绝不存自由色值——
// 否则客户能自助调出对比度不达标的主题、拆掉 V0.3 对比度零点纪律。键名口径唯一真源在
// src/core/domain/theme.ts；实际四套色值只在 tokens.css。脏键读取时经 normalizeThemeKey 回落。
// 单用户免登录 → 全平台一行（id 固定 "platform"，服务层 get-or-create）。
// logoFile 只存**文件名**（非路径、非 URL）：文件落在 public/uploads/branding/（gitignore），
// 渲染时拼固定目录 → 客户端永远无法借文件名做路径穿越；目录与命名由服务端单点生成。
// ─────────────────────────────────────────────────────────────
model PlatformSetting {
  id        String   @id @default("platform") // 单例行主键固定字面量（免 cuid 漂移）
  themeKey  String   @default("cobalt") // 主题插槽键名，仅认 theme.ts 的四套
  logoFile  String? // 品牌 Logo 文件名；null=未上传（品牌区回落文字标识）
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────────
// M10-a 备料一 · 操作流水（OperationLog）—— “这个数是谁、什么时候、改成了什么”的可回放答案
// 立表原因（2026-10-13 与 HAE 确认）：平台将交给内部员工真实使用，逻辑问题只能在使用过程中暴露；
// 而员工口头描述“上周还不是这样”时，我们此前**没有任何办法**重建现场——只有 FinanceRecord.recordedBy、
// AcceptanceNode.reviewedBy 这类零散字段，没有统一流水。本表是那条问题的总兜底，不是审批流（无审批语义）。
// 纪律三条：
// ① **best-effort 写入**：记流水失败绝不允许拖垮业务写入（服务层 try/catch 后转 telemetry 报错，不抛给调用方）。
// ② **只在服务层单点写**（core/domain/operationLog.ts 唯一入口），模块与页面不得自行 insert——
//    与 §4.2 自定义字段同一条思路：埋点散开就必然漏，漏了就等于没有。
// ③ before/after 存**人话摘要文本**而非 JSON：本栈 SQLite 不支持 Json 类型（§1 实测更正），
//    且这张表是给人读的账，不是给程序解析的账。结构化需求将来按需用列扩展，不塞 blob。
// actor 现阶段是占位用户（免登录单用户，P4 接登录后换真 userId），保留列即为登录预留位。
// ─────────────────────────────────────────────────────────────
model OperationLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  action    String // 机器名：quote.save / record.create / plan.markPaid / lead.sign / node.review / project.archive …
  entity    String // 实体类型：project / quote / financeRecord / paymentNode / lead / node / issue / fieldDef / schedule …
  entityId  String? // 实体 id；模板类操作等无单行主体时可空
  projectId String? // ★ 尽量挂主脊：支撑“按项目看这一单都发生过什么”（不建外键——流水要能留住已删对象的记录）
  summary   String // 中文一句话，给业务同事看（不是给程序看）
  before    String? // 变更前关键值（纯文本；null=新建类操作）
  after     String? // 变更后关键值（纯文本；null=删除类操作）
  actor     String   @default("user-local") // 占位用户；P4 换真 userId
  actorName String? // 展示名快照（人员改名后流水仍显示当时的名字）
  error     String? // 失败时记原因；成功为 null（失败的写操作同样值得留档）

  @@index([projectId, at])
  @@index([entity, entityId])
  @@index([at])
  @@map("operation_logs")
}

// ─────────────────────────────────────────────────────────────
// M10-a 备料三 · 线索作废位（Lead.archived）
// 与项目侧的区别：Project 早已有 status="archived"（全司口径本来就排除它），缺的只是入口；
// Lead 只有 stage（商务阶段），没有“这条不做了/录错了”的位——签约不可逆 + 无删除入口，
// 误建线索只能永久留在漏斗里污染阶段存量与签约率。故补作废位，语义＝**从漏斗与统计里摘出去、可恢复**。
// 不做硬删：线索可能已回写 projectId（签约过），删线索会切断项目↔线索的 1-1 溯源（§4.1）。

// ─────────────────────────────────────────────────────────────
// M15-a 全景管理模块（pano）
// 全景**成品**不入库，只进磁盘：MT-Pano 编辑器导出的 `_web` 整包放在
//   public/uploads/pano/<dirName>/  （入口 index.html；资源全为相对路径，实测
//   MT-Panoramic/server/index.js 导出生成器——style.css/marzipano.js/tiles/ 都写相对，
//   只有编辑器自己的预览路由才把它们改写成根绝对。所以整包挂在这个前缀下可直接 iframe 打开）。
// 库里存的是「一条已登记的导览」：属于哪个项目、叫什么、当前是否上架、排第几。
//
// 为什么 dirName 唯一：磁盘目录是全平台唯一的物理位置。两条记录指向同一目录会让
// 上下架与改名互相打架，也让"扫描登记"无法幂等判断「这个目录已经入过库」。
// 为什么不建 PanoScene 子表：场景清单的真源在导览包内（project.json / app.js），
// 抄进库里等于造第二套真源——包里改了、列表还写着旧的，且无从发现。
// 故只存登记那一刻读到的 sceneCount（可为 0：托管版导出会删掉 project.json）。
//
// 删除口径（§4.3）：平台不硬删业务数据。"这条不展示"= status=hidden，**磁盘文件保留**；
// 真要腾空间由人工在服务器上删目录，下一次扫描会把它列成「未登记」而不是报错。
// ─────────────────────────────────────────────────────────────
model PanoTour {
  id         String   @id @default(cuid())
  projectId  String? // 归属项目；null=已登记但还没挂上项目（管理页单列出来提醒，不静默隐藏）
  dirName    String   @unique // 磁盘目录名 = public/uploads/pano/<dirName>，登记后不可改（改了就和文件失联）
  title      String // 展示标题（登记时默认取导览包 settings.title，可在管理页改）
  sceneCount Int      @default(0) // 登记时从包里读到的场景数；0=托管版导出没留 project.json，只能人工填
  coverKey   String? // 封面相对 public 的键，**不存前导斜杠**（与 FileAsset.storageKey 同口径）
  status     String   @default("published") // published / hidden
  order      Int      @default(0) // 同一项目内的展示次序，小在前
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, status, order])
  @@index([status])
  @@map("pano_tours")
}
// ─────────────────────────────────────────────────────────────
