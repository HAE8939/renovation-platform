// Prisma schema — renovation-platform
// SQLite for M1a; kept portable (no PG-only types: no String[], no dbgenerated,
// no native enums) so P5 can switch provider to PostgreSQL in one step.
// Enums are modeled as string + const in TS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 共享核心域 (core/domain) — AGENTS §4
// 预算 / 项目管理 / 设计管理 都挂在 Project 下，禁止模块重复定义。
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  clients Client[]
  users   User[]
  leads   Lead[]

  @@map("organizations")
}

// 占位表：P4 接入登录。表先建、字段留足，暂不实现认证逻辑。
model User {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  email     String   @unique
  role       String   @default("viewer") // owner / designer / pm / viewer…（字符串常量，见 core/domain/types.ts）
  department String?                      // management | business | design | engineering
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id])
  projects Project[]

  @@map("clients")
}

model Project {
  id         String   @id @default(cuid())
  code       String   @unique // 项目编号，如 RP-2026-001
  name       String
  address    String?
  area       Float    @default(0) // 建筑面积㎡；0 时单方造价不可算
  clientId   String
  designer   String?
  pm         String?
  status     String   @default("draft") // draft / design / in_progress / acceptance / completed / archived
  startDate  DateTime?
  endDate    DateTime?                  // 计划/预计完工（B3「工期止」即此）
  contractAmount Float  @default(0)     // 合同额；0=未录入（哨兵，budgetLight/毛利遇 0 走中性）
  houseType  String?                    // 户型
  style      String?                    // 风格偏好
  source     String?                    // 获客渠道（签约时从 Lead.source 带入，供驾驶舱归因）
  inspector  String?                    // 工程巡检（本期文本，P4 再改 userId）
  budgetAnalyst String?                 // 预算员（同上）
  actualEndDate DateTime?               // 实际完工
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client Client       @relation(fields: [clientId], references: [id])
  quotes BudgetQuote[]
  lead    Lead?                        // 反向：签约线索（真源在 Lead.projectId @unique）

  @@map("projects")
}

// ─────────────────────────────────────────────────────────────
// 预算模块自有实体 (modules/budget) — AGENTS §5
// 模块表通过 projectId 外键引用核心域。
// ─────────────────────────────────────────────────────────────

model CatalogCategory {
  id        String  @id @default(cuid())
  name      String
  order     Int     @default(0)
  createdAt DateTime @default(now())

  items CatalogItem[]

  @@map("catalog_categories")
}

model CatalogItem {
  id          String  @id @default(cuid())
  categoryId  String
  code        String
  name        String
  unit        String  @default("项")
  defaultPrice Float  @default(0)
  defaultQty   Float  @default(1)
  materials   String  @default("") // 材料说明
  sop         String  @default("") // 施工要求，多行文本按 \n 分行
  order       Int     @default(0)
  createdAt   DateTime @default(now())

  category CatalogCategory @relation(fields: [categoryId], references: [id])

  @@map("catalog_items")
}

model BudgetQuote {
  id        String   @id @default(cuid())
  projectId String   @unique // M1a：一项目一报价；多版本留 M1b
  taxRate   Float    @default(0.03)
  status    String   @default("draft") // draft / confirmed / locked
  note      String?
  lockedAt  DateTime?                  // 签约锁单时刻；null=未锁
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id])
  items   QuoteItem[]

  @@map("budget_quotes")
}

// 报价明细：CatalogItem 的快照，非引用。
// 改模板不回溯历史报价 —— 这是刻意的领域决策（AGENTS §5）。
model QuoteItem {
  id           String  @id @default(cuid())
  quoteId      String
  categoryName String // 快照科目名
  code         String
  name         String
  unit         String  @default("项")
  unitPrice    Float   @default(0)
  quantity     Float   @default(1)
  materials    String  @default("")
  sop          String  @default("")
  order        Int     @default(0)

  quote BudgetQuote @relation(fields: [quoteId], references: [id])

  @@map("quote_items")
}

// ─────────────────────────────────────────────────────────────
// M2-A 全案主脊：线索与跟进（core/domain 主数据）
// Lead = 签约前线索；FollowUp = 1-N 跟进记录（非长文本）。
// 本期只落表，不接页面；M3 才从 Lead 签约回写 Project.projectId。
// ─────────────────────────────────────────────────────────────

model Lead {
  id           String    @id @default(cuid())
  orgId        String
  code         String    @unique // LEAD-YYYY-NNN
  name         String
  phone        String?   // 归并键（M3 签约按此并 Client）
  estate       String?   // 楼盘
  area         Float     @default(0)
  style        String?
  budgetRange  String?   // 意向预算区间（文本，非精确）
  source       String?   // 获客渠道
  stage        String    @default("leads") // leads | contacted | confirmed | quoted | signed
  intentLevel  String    @default("medium") // high | medium | low
  assignee     String?   // 负责人（本期文本）
  lastFollowAt DateTime?
  nextFollowAt DateTime?
  projectId    String?   @unique // 签约回写，1-1；未签为 null
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org       Organization @relation(fields: [orgId], references: [id])
  project   Project?     @relation(fields: [projectId], references: [id])
  followUps FollowUp[]

  @@map("leads")
}

model FollowUp {
  id           String    @id @default(cuid())
  leadId       String
  date         DateTime  @default(now())
  content      String
  nextFollowAt DateTime?
  createdAt    DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("follow_ups")
}
