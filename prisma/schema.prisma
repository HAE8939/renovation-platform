// Prisma schema — renovation-platform
// SQLite for M1a; kept portable (no PG-only types: no String[], no dbgenerated,
// no native enums) so P5 can switch provider to PostgreSQL in one step.
// Enums are modeled as string + const in TS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 共享核心域 (core/domain) — AGENTS §4
// 预算 / 项目管理 / 设计管理 都挂在 Project 下，禁止模块重复定义。
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  clients Client[]
  users   User[]
  leads   Lead[]

  @@map("organizations")
}

// 占位表：P4 接入登录。表先建、字段留足，暂不实现认证逻辑。
model User {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  email     String   @unique
  role       String   @default("viewer") // owner / designer / pm / viewer…（字符串常量，见 core/domain/types.ts）
  department String?                      // management | business | design | engineering
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id])
  projects Project[]

  @@map("clients")
}

model Project {
  id         String   @id @default(cuid())
  code       String   @unique // 项目编号，如 RP-2026-001
  name       String
  address    String?
  area       Float    @default(0) // 建筑面积㎡；0 时单方造价不可算
  clientId   String
  designer   String?
  pm         String?
  status     String   @default("draft") // draft / design / in_progress / acceptance / completed / archived
  startDate  DateTime?
  endDate    DateTime?                  // 计划/预计完工（B3「工期止」即此）
  contractAmount Float  @default(0)     // 合同额；0=未录入（哨兵，budgetLight/毛利遇 0 走中性）
  houseType  String?                    // 户型
  style      String?                    // 风格偏好
  source     String?                    // 获客渠道（签约时从 Lead.source 带入，供驾驶舱归因）
  inspector  String?                    // 工程巡检（本期文本，P4 再改 userId）
  budgetAnalyst String?                 // 预算员（同上）
  actualEndDate DateTime?               // 实际完工
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client    Client       @relation(fields: [clientId], references: [id])
  quotes    BudgetQuote[]
  lead      Lead?                        // 反向：签约线索（真源在 Lead.projectId @unique）
  designTasks DesignTask[]               // 反向：设计任务（M5-a，真源在 DesignTask.projectId）
  scheduleTasks ScheduleTask[]           // 反向：排程工序（M6-a，真源在 ScheduleTask.projectId）
  acceptanceNodes AcceptanceNode[]       // 反向：验收节点（M7-a，真源在 AcceptanceNode.projectId）
  issues    Issue[]                       // 反向：质量问题（M7-a，真源在 Issue.projectId）
  financeRecords FinanceRecord[]          // 反向：收支台账（M8-a，真源在 FinanceRecord.projectId）
  paymentNodes PaymentNode[]              // 反向：付款段（M8-a，真源在 PaymentNode.projectId）

  @@map("projects")
}

// ─────────────────────────────────────────────────────────────
// 预算模块自有实体 (modules/budget) — AGENTS §5
// 模块表通过 projectId 外键引用核心域。
// ─────────────────────────────────────────────────────────────

model CatalogCategory {
  id        String  @id @default(cuid())
  name      String
  order     Int     @default(0)
  createdAt DateTime @default(now())

  items CatalogItem[]

  @@map("catalog_categories")
}

model CatalogItem {
  id          String  @id @default(cuid())
  categoryId  String
  code        String
  name        String
  unit        String  @default("项")
  defaultPrice Float  @default(0)
  defaultQty   Float  @default(1)
  materials   String  @default("") // 材料说明
  sop         String  @default("") // 施工要求，多行文本按 \n 分行
  order       Int     @default(0)
  createdAt   DateTime @default(now())

  category CatalogCategory @relation(fields: [categoryId], references: [id])

  @@map("catalog_items")
}

model BudgetQuote {
  id        String   @id @default(cuid())
  projectId String   @unique // M1a：一项目一报价；多版本留 M1b
  taxRate   Float    @default(0.03)
  status    String   @default("draft") // draft / confirmed / locked
  note      String?
  lockedAt  DateTime?                  // 签约锁单时刻；null=未锁
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id])
  items   QuoteItem[]

  @@map("budget_quotes")
}

// 报价明细：CatalogItem 的快照，非引用。
// 改模板不回溯历史报价 —— 这是刻意的领域决策（AGENTS §5）。
model QuoteItem {
  id           String  @id @default(cuid())
  quoteId      String
  categoryName String // 快照科目名
  code         String
  name         String
  unit         String  @default("项")
  unitPrice    Float   @default(0)
  quantity     Float   @default(1)
  materials    String  @default("")
  sop          String  @default("")
  order        Int     @default(0)

  quote BudgetQuote @relation(fields: [quoteId], references: [id])

  @@map("quote_items")
}

// ─────────────────────────────────────────────────────────────
// M2-A 全案主脊：线索与跟进（core/domain 主数据）
// Lead = 签约前线索；FollowUp = 1-N 跟进记录（非长文本）。
// 本期只落表，不接页面；M3 才从 Lead 签约回写 Project.projectId。
// ─────────────────────────────────────────────────────────────

model Lead {
  id           String    @id @default(cuid())
  orgId        String
  code         String    @unique // LEAD-YYYY-NNN
  name         String
  phone        String?   // 归并键（M3 签约按此并 Client）
  estate       String?   // 楼盘
  area         Float     @default(0)
  style        String?
  budgetRange  String?   // 意向预算区间（文本，非精确）
  source       String?   // 获客渠道
  stage        String    @default("leads") // leads | contacted | confirmed | quoted | signed
  intentLevel  String    @default("medium") // high | medium | low
  assignee     String?   // 负责人（本期文本）
  lastFollowAt DateTime?
  nextFollowAt DateTime?
  projectId    String?   @unique // 签约回写，1-1；未签为 null
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org       Organization @relation(fields: [orgId], references: [id])
  project   Project?     @relation(fields: [projectId], references: [id])
  followUps FollowUp[]

  @@map("leads")
}

model FollowUp {
  id           String    @id @default(cuid())
  leadId       String
  date         DateTime  @default(now())
  content      String
  nextFollowAt DateTime?
  createdAt    DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("follow_ups")
}

// ─────────────────────────────────────────────────────────────
// 设计管理模块自有实体 (modules/design) — M5-a
// DesignTask 通过 projectId 外键引用共享 core/domain 的 Project（AGENTS §2/§4）。
// assigneeId / reviewerId 语义上是 User.id（存 userId，非自由文本），
// 但本期不建到 User 的 @relation（User 侧不加反向字段），仅逻辑引用 + @@index
// —— P4 接登录后再决定是否建外键关系，避免现在牵动 User 表。
// ─────────────────────────────────────────────────────────────
model DesignTask {
  id          String   @id @default(cuid())
  projectId   String                     // ★ 引用共享 core/domain Project，不得自造
  code        String   @unique           // DES-YYYY-NNN
  title       String
  type        String                     // scheme|floorplan|rendering|construction_drawing|measurement（见 design/types.ts 常量）
  status      String   @default("pending") // pending|assigned|submitted|revisions|approved（见 design/status.ts）
  assigneeId  String?                    // ★ userId，非自由文本；null=待分配
  reviewerId  String?                    // ★ userId，审核人
  requirement String   @default("")      // 需求说明，多行
  deadline    DateTime?
  priority    String   @default("medium") // high|medium|low
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project        @relation(fields: [projectId], references: [id])
  submissions TaskSubmission[]

  @@index([projectId])
  @@index([assigneeId])
  @@map("design_tasks")
}

// 任务提交记录（版本化）。M5-a 只建表不落数据；提交/审核逻辑 M5-b/M5-c。
model TaskSubmission {
  id           String    @id @default(cuid())
  taskId       String
  version      Int                       // 同 task 自增（服务层算 max+1）
  note         String    @default("")     // 提交说明
  assetRef     String?                    // 交付物链接占位（本期无上传，可空）
  submittedBy  String                     // ★ userId
  result       String    @default("pending") // pending|approved|rejected（本次提交审核结果）
  rejectReason String?                     // 退回时必填（M5-c 服务层校验）
  reviewedBy   String?                     // ★ userId
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  task DesignTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, version])
  @@map("task_submissions")
}

// ─────────────────────────────────────────────────────────────
// 时间管控模块自有实体 (modules/schedule) — M6-a
// ScheduleTask 通过 projectId 外键引用共享 core/domain 的 Project（AGENTS §2/§4）。
// ownerId 语义上是 User.id（存 userId，非自由文本），与 DesignTask.assigneeId 同策略：
// 本期不建到 User 的 @relation，仅逻辑引用 + @@index，P4 接登录后再定外键关系。
// ─────────────────────────────────────────────────────────────

// 工序模板：11 工序 × 3 档（lt90 / b90_130 / gt130），生成排程时按面积档套用。
model ProcessTemplate {
  id        String   @id @default(cuid())
  name      String   // 工序名（11 项）
  order     Int      // 1..11，生成顺序
  tier      String   // lt90 | b90_130 | gt130（见 schedule/plan.ts）
  days      Int      // 标准工期（天）
  createdAt DateTime @default(now())

  @@unique([tier, order])
  @@map("process_templates")
}

// 排程工序：从模板快照生成，挂在 Project 下。改模板不回溯已生成排程。
model ScheduleTask {
  id          String    @id @default(cuid())
  projectId   String                     // ★ 引用共享 core/domain Project，不得自造
  name        String                     // 工序名（快照自模板；改模板不回溯已生成排程）
  order       Int
  startDate   DateTime                   // 计划开始
  endDate     DateTime                   // 计划结束（含当天；=start+days-1）
  actualStart DateTime?
  actualEnd   DateTime?
  progress    Int       @default(0)      // 0–100 整数
  status      String    @default("pending") // pending|in_progress|completed（见 schedule/status.ts）
  ownerId     String?                    // ★ userId，非自由文本；null=未指派
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project    Project                   @relation(fields: [projectId], references: [id])
  deps       ScheduleTaskDependency[]  @relation("sch_dep_task")
  dependents ScheduleTaskDependency[]  @relation("sch_dep_dependson")

  @@index([projectId])
  @@index([ownerId])
  @@map("schedule_tasks")
}

// 自引用依赖中间表：taskId 依赖 dependsOnId（task 的前置 = dependsOn）。
model ScheduleTaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())

  task      ScheduleTask @relation("sch_dep_task", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn ScheduleTask @relation("sch_dep_dependson", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@map("schedule_task_deps")
}

// ─────────────────────────────────────────────────────────────
// 质量管控模块自有实体 (modules/quality) — M7-a
// 节点/问题经 projectId 外键引用共享 core/domain Project；
// node.taskId 为对 ScheduleTask 的【逻辑引用】（跨模块不建 @relation，仿 assigneeId 策略）。
// 检查项库仅 seed 灌入（v5.1 无编辑页）。
// ─────────────────────────────────────────────────────────────

// 检查项库（SOP）：按 stage（=工序名，与 ProcessTemplate.name 同字面）映射 11 工序。
model CheckItem {
  id        String   @id @default(cuid())
  stage     String   // 工序名，如"水电工程"
  name      String   // 检查项名，如"强弱电间距"
  standard  String   // 验收标准
  order     Int      // 工序内排序
  createdAt DateTime @default(now())

  @@unique([stage, order])
  @@map("check_items")
}

// 验收节点：工序完工自动生成（core 整合器），一工序一节点。
model AcceptanceNode {
  id           String    @id @default(cuid())
  projectId    String
  taskId       String?   @unique        // ★ 逻辑引用 ScheduleTask.id；清空排程后允许悬垂
  name         String                    // 工序名快照
  order        Int                       // 工序顺序快照
  status       String    @default("pending") // pending|submitted|returned|passed
  submitNote   String    @default("")    // 提交说明
  submittedBy  String?                   // ★ userId（占位当前用户）
  submittedAt  DateTime?
  reviewedBy   String?                   // ★ userId
  reviewedAt   DateTime?
  returnReason String?                   // 退回原因（最近一次；详情页展示）
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project     @relation(fields: [projectId], references: [id])
  checks  NodeCheck[]
  issues  Issue[]

  @@index([projectId])
  @@index([status])
  @@map("acceptance_nodes")
}

// 节点检查项快照行：生成时从 CheckItem 拷入；提交时填结果。
model NodeCheck {
  id        String   @id @default(cuid())
  nodeId    String
  name      String   // 快照
  standard  String   // 快照
  order     Int
  result    String?  // null=未检 | pass | fail
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  node AcceptanceNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, order])
  @@map("node_checks")
}

// 问题台账：验收退回自动建；亦可手工新建。
model Issue {
  id          String    @id @default(cuid())
  projectId   String
  nodeId      String?                   // 来源节点（手工建可为空）
  title       String                    // 问题标题
  desc        String    @default("")    // 详细描述
  severity    String    @default("normal") // minor|normal|major
  status      String    @default("open")   // open|rectified|closed
  reportedBy  String                    // ★ userId
  assigneeId  String?                   // ★ 责任人 userId
  dueDate     DateTime?                 // 截止日期
  rectifyNote String?                   // 整改说明
  rectifiedAt DateTime?
  recheckNote String?                   // 复验意见（关闭/退回共用，取最近一次）
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project         @relation(fields: [projectId], references: [id])
  node    AcceptanceNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@map("issues")
}

// ─────────────────────────────────────────────────────────────
// 财务管控模块自有实体 (modules/finance) — M8-a
// 收支记录与付款段均经 projectId 外键引用共享 core/domain Project。
// 付款段的「解锁/可收款」态【不落库】：读取时由 finance/payment.ts 纯函数派生（决策①）。
// paid/paidAt/paidBy 是唯一落库的执行事实（人工标记），不自动生 FinanceRecord（决策②）。
// ─────────────────────────────────────────────────────────────

// 收支台账：录入即入账（无审批态，§0 范围红线）。
model FinanceRecord {
  id          String   @id @default(cuid())
  projectId   String
  type        String   // income | expense
  category    String   // contract | change | refund | material | labor | other
  amount      Float                       // 恒为正数；方向由 type 决定（免符号歧义）
  date        DateTime                    // 发生日期
  description String   @default("")       // 摘要，如「泥工班组第二期人工」
  recordedBy  String?                     // ★ userId（占位当前用户，P4 接登录）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([type])
  @@index([date])
  @@map("finance_records")
}

// 付款段：五段计划，金额生成时快照自 Project.contractAmount（决策④）。
model PaymentNode {
  id             String    @id @default(cuid())
  projectId      String
  order          Int                      // 1..5
  name           String                   // 段名快照，如「水电完成款」
  percent        Float                    // 比例快照（30 = 30%），展示用
  amountDue      Float                    // ★ 应收金额快照（生成时合同额 × 比例，尾差归末段）
  trigger        String                   // none | stages | all  —— 解锁依赖的验收条件
  triggerStages  String    @default("")    // 逗号分隔工序名，仅 trigger=="stages" 用
  unlocksAt      DateTime?                // 可选：不早于此日可付（保修金用；null=无日期约束）
  note           String    @default("")
  paid           Boolean   @default(false)
  paidAt         DateTime?
  paidBy         String?                  // ★ userId
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, order])
  @@index([projectId])
  @@map("payment_nodes")
}
